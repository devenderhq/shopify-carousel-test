  {{ 'carousel-section.css' | asset_url | stylesheet_tag }}

<section class="carousel">
  <div class="carousel_section_heading">
    <h1>{{ section.settings.heading }}</h1>
  </div>

  {% assign selected_collection = collections[section.settings.collection] %}

{% if selected_collection != blank %}

    <div class="collection-products">
    <button type="button" class="slider-prev" aria-label="Previous products">
        &#10094;
    </button>
    <div class="keen-slider">
        {% for product in selected_collection.products limit: section.settings.products_limit %}

            <div class="product_card keen-slider__slide">
                <a href="{{ product.url }}">
        {% if product.featured_image %}
          <img
            src="{{ product.featured_image | image_url: width: 400 }}"
            alt="{{ product.title | escape }}"
            width="400"
            height="400"
            loading="lazy"
          >
        {% endif %}
      </a>

      <!-- Product Title -->
      <h3 class="product_title">
        <a href="{{ product.url }}">
          {{ product.title }}
        </a>
      </h3>

      <!-- Product Price -->
      <p class="product_price">
        {{ product.price | money }}
      </p>

{% if product.has_only_default_variant %}
<add-to-cart variant-id="{{ product.selected_or_first_available_variant.id }}">
  <button type="button">
    Add to Cart
  </button>
</add-to-cart>{% else %}
  <a class="selections_button" href="{{ product.url}}">
    Select Options
  </a>
{% endif %}
     
            </div>
          

        {% endfor %}
    </div>
     <button type="button" class="slider-next" aria-label="Next products">
        &#10095;
    </button>

    </div>
{% endif %}

<div class="add_success_popup_container">
    <div class="add_success_popup_data">

        <button type="button" class="close_success_popup">
            Close
        </button>

        <div class="added_item_info">
            <img class="added_product_image" src="" alt="">

            <h3 class="added_product_title"></h3>
        </div>

        <a href="#">Continue Shopping</a>
        <a href="/cart">View Cart</a>

    </div>
</div>

</section>
<script src="https://cdn.jsdelivr.net/npm/keen-slider@latest/keen-slider.js"></script>


  <script>
  const slider = new KeenSlider(".keen-slider", {
    loop: true,
    slides: {
        perView: 4,
        spacing: 15,
    },
    breakpoints: {
        "(max-width: 1024px)": {
            slides: {
                perView: 3,
                spacing: 15,
            },
        },
        "(max-width: 768px)": {
            slides: {
                perView: 2,
                spacing: 15,
            },
        },
        "(max-width: 480px)": {
            slides: {
                perView: 1,
                spacing: 15,
            },
        },
    },
});

document.querySelector(".slider-prev").addEventListener("click", () => {
    slider.prev();
});

document.querySelector(".slider-next").addEventListener("click", () => {
    slider.next();
});
  </script>

{{ 'carousel-section.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Carousel",
  "class":"carousel_parent",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Carousel"
    }
  ]
}
{% endschema %}